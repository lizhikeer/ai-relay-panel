# ===== ai-relay-panel 配置模板 =====
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会入库。

# --- New API 后端引擎 ---
# 容器 new-api 使用 host 网络，监听 127.0.0.1:3000
NEWAPI_BASE_URL=http://127.0.0.1:3000
# New API 管理员账号（BFF 用它自动登录并缓存 admin token）
NEWAPI_ADMIN_USER=LzK
NEWAPI_ADMIN_PASSWORD=changeme

# --- 面板自身登录 ---
PANEL_USER=LzK
PANEL_PASSWORD=changeme
# 随机字符串，用于签名 session cookie
# 生成: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
PANEL_SESSION_SECRET=change-this-to-a-random-string

# --- 服务 ---
# ⚠️ NAS 上 8080 已被 xray-camouflage-nginx 占用，故用 18080
# （与现有服务端口段一致：upsnap=18090）
LISTEN_PORT=18080
